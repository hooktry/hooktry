{
  "name": "@hooktry/cloudflare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run typecheck && npm run check:scripts && npm test",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check:scripts": "node --check scripts/bootstrap-production-resources.mjs && node --check scripts/smoke-production.mjs && node --check scripts/render-preview-config.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.1",
    "@cloudflare/workers-types": "5.20261001.1",
    "typescript": "7.0.2",
    "vitest": "4.1.0",
    "wrangler": "4.143.0"
  }
}
