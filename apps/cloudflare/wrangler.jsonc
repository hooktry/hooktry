{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hooktry-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hooktry-cloudflare",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAYLOADS",
      "bucket_name": "hooktry-payloads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXPOSURES",
        "class_name": "ExposureRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ExposureRuntime"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/hook/*",
      "/view/*",
      "/claim/*",
      "/healthz",
      "/mcp"
    ]
  }
}
