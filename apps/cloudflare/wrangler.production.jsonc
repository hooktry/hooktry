{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ortyo-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ortyo-cloudflare",
      "database_id": "60eaa4ee-ce8d-4663-99c6-1df794ec47f8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAYLOADS",
      "bucket_name": "ortyo-payloads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXPOSURES",
        "class_name": "ExposureRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ExposureRuntime"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/hook/*",
      "/view/*",
      "/claim/*",
      "/open",
      "/healthz",
      "/mcp"
    ]
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "hooktry.com",
      "custom_domain": true
    },
    {
      "pattern": "mcp.hooktry.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "HOOKTRY_PUBLIC_ORIGIN": "https://hooktry.com"
  },
  "previews": {
    "vars": {},
    "observability": {
      "enabled": true
    }
  }
}
